# ═══════════════════════════════════════════════════════════════
#  cella 数据库系统 —— .gitignore
#  原则：只跟踪源码、文档与测试脚本；构建产物与运行期生成的数据不入库
# ═══════════════════════════════════════════════════════════════

# ── 构建产物 ──────────────────────────────────────────────────
build/
build_dbg/
cella_sql/build/
cella_storage/build*/
cella_storage/out/
cella_storage/.vs/

# ── 运行期生成的数据库文件 / 测试数据（含 *.db *.meta *.log）────
mydb/
cella_storage/demo_data/
**/test_data/
*_data/

# ── 日志与临时文件 ────────────────────────────────────────────
*.log
_*.txt

# ── 旧模块仓库遗留（cella_sql 原独立克隆的 .git，已失效，仅留档备份）──
_legacy_git_backup/

# ── 助手工作记忆（如需纳入版本管理，删除这一行即可）─────────────
.workbuddy/

# ── 编辑器 / 操作系统 ─────────────────────────────────────────
.vs/
*.user
*.suo
Thumbs.db
.DS_Store

# ── 历史遗留（沿用 cella_sql 原有 .gitignore 的规则）────────────
cella_prompt/
